#!/usr/bin/env python3
"""Run Codex with independent ChatGPT accounts, or resume a shared local thread."""
import argparse
from contextlib import ExitStack
import fcntl
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import uuid

ROOT = Path(os.environ.get('CX_ROOT', Path.home() / '.local/share/cx')).expanduser()
LEGACY = Path(os.environ.get('CX_LEGACY_HOME', Path.home() / '.codex')).expanduser()
CODEX = os.environ.get('CX_CODEX_BIN', 'codex')
NAME = re.compile(r'^[A-Za-z0-9][A-Za-z0-9_-]{0,39}$')


def fail(message):
    raise SystemExit(f'cx: {message}')


def profile_dir(name, create=False):
    if not NAME.fullmatch(name):
        fail('account name must contain only letters, digits, _ or -')
    path = ROOT / 'accounts' / name
    if create:
        path.mkdir(parents=True, exist_ok=True, mode=0o700)
        path.chmod(0o700)
        config = path / 'config.toml'
        if not config.exists():
            config.write_text('model_context_window = 500000\n')
            config.chmod(0o600)
    return path


def account_home(name, create=False):
    path = profile_dir(name, create)
    return LEGACY if (path / 'current-home.link').exists() else path


def atomic_copy(source, target):
    target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, temp = tempfile.mkstemp(prefix='.cx-', dir=target.parent)
    try:
        with os.fdopen(fd, 'wb') as output, source.open('rb') as input_file:
            shutil.copyfileobj(input_file, output)
            output.flush()
            os.fsync(output.fileno())
        os.chmod(temp, 0o600)
        os.replace(temp, target)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def invoke(home, args):
    env = os.environ.copy()
    env['CODEX_HOME'] = str(home)
    return subprocess.call([CODEX, *args], env=env)


def lock_shared():
    ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
    ROOT.chmod(0o700)
    handle = (ROOT / 'shared.lock').open('a+')
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        fail('shared history is in use by another cx switch session')
    return handle


def lock_home(home, exclusive=False):
    locks = ROOT / 'locks'
    locks.mkdir(parents=True, exist_ok=True, mode=0o700)
    locks.chmod(0o700)
    name = 'legacy' if home == LEGACY else home.name
    handle = (locks / f'{name}.lock').open('a+')
    mode = fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH
    try:
        fcntl.flock(handle, mode | fcntl.LOCK_NB)
    except BlockingIOError:
        fail(f'{name} is in use by another cx session')
    return handle


def invoke_locked(home, args, exclusive=False):
    lock = lock_home(home, exclusive)
    try:
        return invoke(home, args)
    finally:
        lock.close()


def session_home(session_id):
    try:
        uuid.UUID(session_id)
    except ValueError:
        fail('conversation ID must be a UUID')
    homes = [LEGACY]
    profiles = ROOT / 'accounts'
    if profiles.exists():
        homes.extend(path for path in profiles.iterdir() if path.is_dir() and NAME.fullmatch(path.name))
    matches = [home for home in homes if any((home / 'sessions').rglob(f'*-{session_id}.jsonl'))]
    if not matches:
        fail(f'no local session found with ID {session_id}; check the ID and account')
    if len(matches) > 1:
        fail(f'session {session_id} exists in multiple profiles; resolve the duplicate before switching')
    return matches[0]


def recover_locked(backup_dir=None):
    backup_dir = backup_dir or ROOT / 'shared-backup'
    backup = backup_dir / 'auth.json'
    marker = backup_dir / 'account.json'
    if not marker.exists():
        return False
    if not backup.exists():
        fail('recovery marker exists but original auth backup is missing')
    try:
        name = json.loads(marker.read_text())['account']
        target = account_home(name, create=True) / 'auth.json'
        source = json.loads(marker.read_text()).get('source', 'legacy')
        home = LEGACY if source == 'legacy' else account_home(source)
        current = home / 'auth.json'
        if current.exists() and current.read_bytes() != backup.read_bytes():
            atomic_copy(current, target)
        atomic_copy(backup, current)
        marker.unlink()
        backup.unlink()
        return True
    except (OSError, ValueError, KeyError) as exc:
        fail(f'could not recover shared credentials: {exc}')


def switch(name, session_id, extra, source_home=None):
    source_home = source_home or session_home(session_id)
    if source_home == account_home(name):
        return invoke_locked(source_home, ['--no-daemon', 'resume', session_id, *extra])
    source = 'legacy' if source_home == LEGACY else source_home.name
    profile_auth = account_home(name) / 'auth.json'
    if not profile_auth.is_file():
        fail(f'{name} is not logged in; run: cx login {name}')
    original = source_home / 'auth.json'
    if not original.is_file():
        fail(f'{original} is missing; source session needs an existing Codex login')
    backup_dir = ROOT / 'backups' / source
    with ExitStack() as stack:
        for home in sorted({source_home, account_home(name)}, key=str):
            stack.enter_context(lock_home(home, exclusive=True))
        marker = backup_dir / 'account.json'
        if marker.exists() and json.loads(marker.read_text()).get('account') != name:
            fail(f'interrupted switch in {source}; run: cx recover')
        if recover_locked(backup_dir):
            print(f'cx: recovered credentials for {source}', file=sys.stderr)
        return switch_locked(name, session_id, extra, source_home, source, profile_auth, original, backup_dir)


def switch_locked(name, session_id, extra, source_home, source, profile_auth, original, backup_dir):
    backup_dir.mkdir(parents=True, mode=0o700, exist_ok=True)
    backup_dir.chmod(0o700)
    atomic_copy(original, backup_dir / 'auth.json')
    marker = backup_dir / 'account.json'
    marker.write_text(json.dumps({'account': name, 'source': source}))
    marker.chmod(0o600)
    try:
        atomic_copy(profile_auth, original)
        print(f'cx: resuming {session_id} with {name}; {source} is locked until exit', file=sys.stderr)
        return invoke(source_home, ['--no-daemon', 'resume', session_id, *extra])
    finally:
        recover_locked(backup_dir)


def main():
    parser = argparse.ArgumentParser(description='Codex account profiles and shared-history switching')
    sub = parser.add_subparsers(dest='command', required=True)
    login = sub.add_parser('login', help='sign in to a separate account profile')
    login.add_argument('account')
    login.add_argument('--device-auth', action='store_true')
    imported = sub.add_parser('import-current', help='copy the current ~/.codex login into a profile')
    imported.add_argument('account')
    imported.add_argument('--replace', action='store_true', help='replace a saved login after signing in with codex login')
    linked = sub.add_parser('link-current', help='use the current ~/.codex login and sessions directly')
    linked.add_argument('account')
    status = sub.add_parser('status', help='show account login status')
    status.add_argument('account', nargs='?')
    run = sub.add_parser('run', help='start Codex in an isolated profile')
    run.add_argument('account')
    run.add_argument('args', nargs=argparse.REMAINDER)
    resume = sub.add_parser('resume', help='resume a session in its own profile')
    resume.add_argument('account')
    resume.add_argument('session_id')
    resume.add_argument('args', nargs=argparse.REMAINDER)
    shared = sub.add_parser('switch', help='resume a shared-history UUID under another account')
    shared.add_argument('session_id')
    shared.add_argument('--to', dest='account', required=True)
    sub.add_parser('recover', help='restore credentials after an interrupted switch')
    sub.add_parser('list', help='list local profiles')
    args = parser.parse_args()
    if args.command == 'login':
        home = account_home(args.account, create=True)
        return invoke_locked(home, ['login', *(['--device-auth'] if args.device_auth else [])], exclusive=True)
    if args.command == 'import-current':
        if (ROOT / 'shared-backup' / 'account.json').exists():
            fail('an interrupted switch needs recovery; run: cx recover')
        source = LEGACY / 'auth.json'
        home = account_home(args.account, create=True)
        if home == LEGACY:
            print(f'cx: {args.account} already uses the current login')
            return 0
        target = home / 'auth.json'
        if not source.is_file():
            fail(f'{source} is missing; current login may use a keyring')
        lock = lock_home(home, exclusive=True)
        try:
            if target.exists() and not args.replace:
                fail(f'{args.account} already has credentials; use --replace to update it')
            atomic_copy(source, target)
        finally:
            lock.close()
        print(f'cx: saved current login as {args.account}')
        return 0
    if args.command == 'link-current':
        source = LEGACY / 'auth.json'
        if not source.is_file():
            fail(f'{source} is missing; sign in with codex login first')
        home = profile_dir(args.account, create=True)
        if (home / 'current-home.link').exists():
            print(f'cx: {args.account} already uses the current login')
            return 0
        if any((home / 'sessions').rglob('*.jsonl')):
            fail(f'{args.account} has its own sessions; refusing to hide them')
        lock = lock_home(home, exclusive=True)
        try:
            (home / 'current-home.link').write_text('legacy\n')
            (home / 'current-home.link').chmod(0o600)
            (home / 'auth.json').unlink(missing_ok=True)
        finally:
            lock.close()
        print(f'cx: {args.account} now uses the current Codex login')
        return 0
    if args.command == 'status':
        if args.account:
            return invoke(account_home(args.account, create=True), ['login', 'status'])
        profiles = ROOT / 'accounts'
        if not profiles.exists():
            return 0
        for home in sorted(profiles.iterdir()):
            if home.is_dir() and NAME.fullmatch(home.name):
                print(f'{home.name}:', flush=True)
                invoke(account_home(home.name), ['login', 'status'])
        return 0
    if args.command == 'run':
        return invoke_locked(account_home(args.account, create=True), ['--no-daemon', *args.args])
    if args.command == 'resume':
        target_home = account_home(args.account, create=True)
        source_home = session_home(args.session_id)
        if source_home == target_home:
            return invoke_locked(target_home, ['--no-daemon', 'resume', args.session_id, *args.args])
        return switch(args.account, args.session_id, args.args, source_home)
    if args.command == 'switch':
        return switch(args.account, args.session_id, [])
    if args.command == 'recover':
        recovered = False
        backups = ROOT / 'backups'
        if backups.exists():
            for backup_dir in sorted(backups.iterdir()):
                marker = backup_dir / 'account.json'
                if not marker.exists():
                    continue
                data = json.loads(marker.read_text())
                source = data['source']
                source_home = LEGACY if source == 'legacy' else profile_dir(source)
                with ExitStack() as stack:
                    for home in sorted({source_home, account_home(data['account'])}, key=str):
                        stack.enter_context(lock_home(home, exclusive=True))
                    recovered = recover_locked(backup_dir) or recovered
        lock = lock_shared()
        try:
            recovered = recover_locked() or recovered
        finally:
            lock.close()
        print('cx: recovered' if recovered else 'cx: nothing to recover')
        return 0
    if args.command == 'list':
        profiles = ROOT / 'accounts'
        if profiles.exists():
            for home in sorted(profiles.iterdir()):
                if home.is_dir() and NAME.fullmatch(home.name):
                    linked = (home / 'current-home.link').exists()
                    auth = LEGACY / 'auth.json' if linked else home / 'auth.json'
                    label = ' (current login)' if linked else (' (logged in)' if auth.is_file() else '')
                    print(home.name + label)
        return 0
    return 2


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except OSError as exc:
        fail(str(exc))
